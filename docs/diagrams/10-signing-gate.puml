@startuml signing-gate
title fundsOut signing gate -- TEE validation predicates (handle_sign_evm)

skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam activity {
  BorderColor #355680
  BackgroundColor #FAFAFA
  DiamondBackgroundColor #FFF3CD
  ArrowColor #355680
  FontStyle bold
}

start
:SignEvmRequest received\n(call_data, nonce, deadline, consignment,\nmerkle_proofs, chain_id, proxy_contract, ...);

if (built without `spv` but request\ncarries merkle_proofs?) then (yes)
  #FADBD8:REFUSE -- build/feature mismatch;
  stop
endif

partition "P1  RGB consignment validity (Sec 10.1)" {
  :Transfer::load(consignment_bytes);
  :rgbstd validate() against Esplora resolver;
  if (valid?) then (no)
    #FADBD8:REFUSE -- invalid consignment;
    stop
  endif
  :extract chain_net, witness_txids,\nall_op_ids, last_transition;
  if (contract_id == declared rgb_asset_id?) then (no)
    #FADBD8:REFUSE -- contract_id mismatch;
    stop
  endif
}

partition "P2  EVM cross-checks (validate_evm_request, Sec 10.3/4/5)" {
  if (selector in FUNDS_OUT allowlist?\nlegacy 0x1ad880b2 | mint/burn 0x179bef59) then (no)
    #FADBD8:REFUSE -- unknown selector;
    stop
  endif
  if (consignment bytes present?\n(consignment_valid flag NOT trusted -- #47)) then (no)
    #FADBD8:REFUSE -- fundsOut needs validated consignment;
    stop
  endif
  if (keccak256(consignment)==consignment_hash?) then (no)
    #FADBD8:REFUSE -- consignment tampered;
    stop
  endif
  if (legacy selector: rgb_amount >=\ncalldata_amount + commission\nAND offsets 68/100 match declared?) then (no)
    #FADBD8:REFUSE -- amount / calldata mismatch;
    stop
  endif
  if (chain_id>0 AND proxy_contract is 20B\nAND deadline not expired?) then (no)
    #FADBD8:REFUSE -- bad domain / expired;
    stop
  endif
  if (bridge config pinned (#43)?\nchain_id/proxy_contract/rgb_asset_id == env pins) then (no)
    #FADBD8:REFUSE -- pinned-config mismatch;
    stop
  endif
}

partition "P2b  Amount bound to consignment (#44/#47, Sec 9/10.2/10.3)" {
  if (validated consignment present?\n(rgb_validator ran)) then (no)
    #FADBD8:REFUSE -- fundsOut requires validated consignment;
    stop
  endif
  if (mint/burn: last transition == TS_BURN\nAND calldata amount@36 <= burned_asset_amount?) then (no)
    #FADBD8:REFUSE -- burn amount / type mismatch;
    stop
  endif
  if (legacy: last transition == TS_TRANSFER\nAND amount+commission <= total_output_amount?) then (no)
    #FADBD8:REFUSE -- transfer amount / type mismatch;
    stop
  endif
}

partition "P3  SPV / Bitcoin anchoring (Sec 10.7/8, Sec 12)" {
  if (chain tip fresh? (not stale / not future)) then (no)
    #FADBD8:REFUSE -- chain stale (frozen feed);
    stop
  endif
  if (consignment chain_net == enclave network?) then (no)
    #FADBD8:REFUSE -- cross-network replay;
    stop
  endif
  :for EVERY witness txid: coverage (set equality),\ninclusion proof vs stored header root,\nconfirmation depth >= 6;
  if (all proofs pass?) then (no)
    #FADBD8:REFUSE -- SPV failure;
    stop
  endif
}

partition "Sign" {
  :build EIP-712 domain(name, version, chain_id, proxy_contract);
  :digest = EIP-712( SignRequest(callData, nonce, deadline) );
  :signature = ECDSA over digest (Active KeyManager);
  #D5F5E3:RETURN EvmSignatureResponse{ signature };
}
stop

note right
  CLOSED since original review (see spec-conformance.md):
   - Sec 9 / 10.2  burn amount now bound to the consignment
       (TS_BURN + amount <= burned_asset_amount, #44),
       transfer amount <= total_output_amount (#47)
   - Sec 10.1      consignment_valid bypass removed (#47)
   - Sec 10.4/5    chain_id / contract / asset pinned from env (#43)

  REMAINING GAPS vs spec:
   - Sec 10.6  OpId binding NOT checked / NOT in payload
   - Sec 13    EVM recipient NOT derived from / bound to RGB payload
   - amount bind is `<=`, not the spec's strict `==`
   - EIP-712 domain name/version hardcoded ("Tricorn"/"1")
   - mint/burn path inert until listener emits 0x179bef59
end note

@enduml
