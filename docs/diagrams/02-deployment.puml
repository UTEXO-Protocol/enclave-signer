@startuml deployment
title UTEXO Bridge Enclave-Signer -- Deployment

skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam roundCorner 6

skinparam node {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
skinparam database {
  BackgroundColor #FFF6E0
  BorderColor #A07700
}
skinparam cloud {
  BackgroundColor #EDF3FF
  BorderColor #355680
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #555555
}

' =====================================================================
' Trust zones
' =====================================================================
cloud "Internet\n(untrusted)" as Net {
  actor "External\nverifier" as Verifier
}

node "Orchestrator host\n(operator-controlled)" as OrcHost {
  component "Go Listener\n(federated-signer-node)" as Listener
}

' =====================================================================
' EC2 instance (Nitro-enabled, m5n/m6i/etc)
' =====================================================================
node "EC2 instance -- Nitro-enabled\n(UNTRUSTED parent host)" as EC2 {

  component "utexo-bridge-parent\n(tonic gRPC, 127.0.0.1:5000)" as Parent
  note right of Parent
    Bound to 127.0.0.1 only.
    30 s timeout per enclave RPC.
    USE_VSOCK=true in production.
  end note

  component "utexo-bridge-parent-cli\nattest-verify CLI" as Cli

  component "vsock-proxy\n(port 8001)" as VsockProxy
  note right of VsockProxy
    Allowlist points to the
    Esplora endpoint only.
  end note

  ' Nitro enclave child VM
  node "AWS Nitro Enclave\n(TRUSTED, PCR-pinned)" as Enclave {

    component "utexo-bridge-enclave\n(static-linked Rust)" as EnclaveBin
    note right of EnclaveBin
      Listens on vsock CID 16, port 5000.
      One connection = one request.
      No filesystem persistence.
      No shell. No /dev access
      except /dev/nsm.
      Bridge config pinned from env at boot
      (EVM_CHAIN_ID / BRIDGE_CONTRACT /
       RGB_ASSET_ID) -> bound into attestation.
    end note

    database "Header chain\n(in-memory)" as Headers
    database "EnclaveState\n(Phase + KeyManager\nin SecretBox)" as State
    database "NonceReplayGuard\n(<=10 000 entries)" as Replay

    component "vsock_forwarder\nTCP 127.0.0.1:3443 -> vsock" as Fwd
    component "RgbValidator\n(rgbstd + Esplora HTTP)" as RgbVal

    node "/dev/nsm\nNitro Security Module" as NSM
  }
}

' =====================================================================
' External
' =====================================================================
cloud "Esplora API" as Esplora

' =====================================================================
' Wires
' =====================================================================
Verifier  --> Parent      : gRPC /50051\nAttestedPublicKey(nonce)
Listener  --> Parent      : gRPC /5000\nSign / PublicKey /\nSubmitHeaders ...
Cli       --> Enclave     : direct enclave RPC (dev/ops only)\nTCP 127.0.0.1:5000 or vsock CID 16:5000

Parent    --> Enclave     : vsock CID 16:5000\n[u32 LE len][EnclaveRequest]\n[u32 LE len][EnclaveResponse]

EnclaveBin --> State
EnclaveBin --> Replay
EnclaveBin --> Headers
EnclaveBin --> RgbVal
EnclaveBin --> NSM        : DescribePCR / Attestation
EnclaveBin --> Fwd        : (intra-enclave loopback)
RgbVal     --> Fwd
Fwd        --> VsockProxy : vsock CID 3:8001
VsockProxy --> Esplora    : real HTTP

' =====================================================================
' Notes about images / build
' =====================================================================
note bottom of Enclave
  Built as EIF via `nitro-cli build-enclave`
  from `build/Dockerfile.enclave`. PCR0/1/2
  pinned at build time; any change in source
  -> different PCRs -> external verifier rejects.
end note

note bottom of EC2
  Cluster of N>=2 EC2s share one HD seed via the
  cloning handshake. Each node holds an identical
  `KeyManager` after `Cloning -> Active`.
end note

@enduml
