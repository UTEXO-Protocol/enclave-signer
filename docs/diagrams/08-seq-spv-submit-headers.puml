@startuml seq-submit-headers
title SubmitHeaders -- Listener-driven SPV chain sync

skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #355680
  LifeLineBorderColor #555555
  ParticipantBorderColor #355680
  ParticipantBackgroundColor #FAFAFA
  ParticipantFontStyle bold
}

participant "Go Listener"          as Listener
participant "Esplora API"          as Esplora
participant "utexo-bridge-parent\ngrpc_server.rs" as Parent
participant "enclave/server.rs\nhandle_submit_headers" as Srv
participant "spv::HeaderChain"      as Chain
participant "spv::validation"       as Val
participant "spv::checkpoint"       as Cp

== Bootstrap ==
Listener -> Parent    : gRPC GetLastSavedBlock
Parent -> Srv         : GetLastSavedBlockRequest
Srv -> Chain          : tip_height + tip_hash
Chain --> Srv         : (height, hash) -- checkpoint when empty
Srv --> Parent        : GetLastSavedBlockResponse
Parent --> Listener   : tip = N

== Fetch + push loop ==
loop while remote_tip > N
  Listener -> Esplora : GET /block-height/{N+1..N+500}
  Esplora --> Listener: raw 80-byte headers
  Listener -> Parent  : gRPC SubmitHeaders{start_height=N+1, headers[]}
  Parent -> Srv       : SubmitHeadersRequest

  Srv -> Chain        : submit_headers(start_height, &headers)
  Chain -> Chain      : check bounds:\nstart_height > checkpoint  AND\nstart_height <= tip+1
  Chain -> Chain      : reorg_depth := (tip+1) - start_height
  Chain -> Chain      : require reorg_depth <= MAX_REORG_DEPTH (100)

  loop staged in batch
    Chain -> Chain    : deserialize 80-byte Header (atomic fail)
    Chain -> Cp       : epoch_start_time(...) on retarget heights
    Chain -> Val      : expected_bits(height, prev_bits, prev_time,\nepoch_start_time, network)
    Val --> Chain     : Some(bits) for mainnet/testnet3,\nNone for signet/regtest
    Chain -> Val      : validate_header_full(\nheader, height, prev_hash, expected_bits, net)
    Val -> Val        : check_linkage (prev_blockhash equality)
    Val -> Val        : nBits match if Some(expected)
    Val -> Val        : check_pow (skipped on signet/regtest)
    Val --> Chain     : Ok or SpvError
  end

  alt reorg_depth > 0
    Chain -> Chain    : compare cumulative Work:\nrequire sum(new) > sum(existing)
    Chain -> Chain    : else: SpvError::WeakerChain
    Chain -> Chain    : truncate displaced tail
  end

  Chain -> Chain      : append all staged (all-or-nothing)
  Chain --> Srv       : SubmitOutcome{last_height, last_hash,\nheaders_accepted, reorg_depth}

  Srv --> Parent      : SubmitHeadersResponse
  Parent --> Listener : last_block_height = N'
  Listener -> Listener: N := N'
end

note over Chain
  Boot-time invariants:
   - Checkpoint::assert_real_in_release() panics
     on placeholder checkpoint in release builds.
   - header_at(checkpoint.height) returns None
     (we never store the checkpoint header itself,
      only its hash/bits/time metadata).
end note

@enduml
