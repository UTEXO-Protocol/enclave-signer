@startuml seq-cloning
title Enclave-to-enclave seed cloning -- three-message handshake

skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #355680
  LifeLineBorderColor #555555
  ParticipantBorderColor #355680
  ParticipantBackgroundColor #FAFAFA
  ParticipantFontStyle bold
}

actor "Operator" as Op
participant "parent\n(untrusted relay)" as Parent
participant "REQUESTER enclave\n(new, Phase::Initial)" as Req
participant "DONOR enclave\n(existing, Phase::Active)" as Don
participant "Req NSM" as RN
participant "Don NSM" as DN

note over Req, Don
  Both enclaves must have IDENTICAL PCRs
  (same compiled binary) for cloning to succeed.
  The cloning_secret is a pre-shared operator value;
  the donor reads it from UTEXO_CLONING_SECRET.
end note

== Message 1: parent -> requester ==
Op -> Parent         : gRPC Initialize(cloning_secret)
Parent -> Req        : InitiateCloningRequest{\ncloning_secret, cluster_public_key=donor_evm}

Req -> Req           : ensure Phase::Initial
Req -> Req           : ephemeral X25519 keypair\n(StaticSecret + PublicKey)
Req -> Req           : digest := HMAC-SHA256(secret, encryption_pubkey)
Req -> Req           : nonce := getrandom_32()
Req -> RN            : NSM Attestation(\nnonce, public_key=encryption_pubkey,\nuser_data=digest)
RN --> Req           : requester_attestation (COSE_Sign1)
Req -> Req           : state := Phase::Cloning(session, cluster_pk)

Req --> Parent       : InitiateCloningResponse{\nrequester_attestation,\nencryption_pubkey, cloning_digest}

== Message 2: parent -> donor ==
Parent -> Don        : GetCloneRequest{\ncluster_public_key, cloning_digest,\nencryption_pubkey, requester_attestation}

Don -> Don           : ensure Phase::Active
Don -> Don           : cluster_public_key == my evm_address ?
Don -> DN            : read_own_pcrs()
DN --> Don           : ExpectedPcrs{pcr0,pcr1,pcr2}
Don -> Don           : verify_peer_attestation(\nrequester_attestation, expected=own_PCRs, nonce=None)
note right
  Cert-chain -> AWS Nitro root,
  COSE_Sign1 signature, PCR equality.
  No expected_nonce -- freshness is enforced
  by the replay guard immediately after.
end note
Don -> Don           : replay_guard.check_and_record(verified.nonce)
Don -> Don           : verified.public_key == encryption_pubkey  (pubkey binding)
Don -> Don           : verified.user_data  == cloning_digest    (digest binding)
Don -> Don           : with_donor_cloning_secret:\nHMAC(secret, encryption_pubkey) == cloning_digest
Don -> Don           : with_seed: (ct, donor_pubkey) :=\nencrypt_seed_for_peer(encryption_pubkey, seed)
note right of Don
  encrypt_seed_for_peer:
    our_eph := EphemeralSecret::random
    shared := our_eph * encryption_pubkey
    reject_non_contributory(shared)   <- small-order point guard
    key := HKDF-SHA256(shared,
              salt="utexo-cloning-v1",
              info="seed-encryption"
                    || donor_pub || requester_pub)
    ct := ChaCha20Poly1305(key, nonce=[0;12]).encrypt(seed)
end note
Don -> Don           : donor_nonce := getrandom_32()
Don -> DN            : NSM Attestation(\ndonor_nonce, public_key=donor_pubkey, user_data=None)
DN --> Don           : donor_attestation
Don --> Parent       : GetCloneResponse{\nencrypted_seed, donor_pubkey, donor_attestation}

== Message 3: parent -> requester ==
Parent -> Req        : SetCloneRequest{\nencrypted_seed, donor_pubkey, donor_attestation}

Req -> RN            : read_own_pcrs()
RN --> Req           : ExpectedPcrs
Req -> Req           : verify_peer_attestation(\ndonor_attestation, expected=own_PCRs, nonce=None)
Req -> Req           : replay_guard.check_and_record(verified.nonce)
Req -> Req           : verified.public_key == donor_pubkey
Req -> Req           : complete_cloning {\n  seed := session.decrypt_seed_from_peer(donor_pubkey, ct)\n  km := KeyManager::from_seed(seed, network)\n  assert km.evm_address() == session.cluster_public_key\n  return km\n}
Req -> Req           : state := Phase::Active(km)

Req --> Parent       : SetCloneResponse{} (empty)
Parent --> Op        : Initialize OK (probes GetPublicKey for confirmation)

note over Req, Don
  After SetClone the requester has the IDENTICAL HD seed
  as the donor and signs as the same address. The plaintext
  seed exists only inside the requester's TEE briefly
  (Zeroizing<[u8;64]>); ciphertext on the wire is bound to
  the per-handshake DH key by HKDF info = donor||requester.
end note

@enduml
