@startuml components
title UTEXO Bridge Enclave-Signer -- Component Structure

skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam roundCorner 8

skinparam component {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
skinparam package {
  BackgroundColor #F0F4F8
  BorderColor #355680
  FontStyle bold
}
skinparam interface {
  BackgroundColor #FFE9A8
  BorderColor #C28A00
}

' =====================================================================
' External actors
' =====================================================================
actor "External\nverifier\n(attest-verify)" as Verifier
actor "Operator /\nCLI user"     as Operator
component "Go Listener\n(federated-signer-node)" as Listener

' =====================================================================
' parent crate
' =====================================================================
package "parent crate (utexo-bridge-parent)" as ParentPkg {
  component "main.rs\ngRPC server\n(tonic, 127.0.0.1)"        as ParentMain
  component "grpc_server.rs\nParentAdapterService\n(gRPC <-> enclave wire)" as GrpcSrv
  component "client.rs\nEnclaveClient\n(TCP / vsock)"          as ParentClient
  component "framing.rs\n[u32 LE len][protobuf]"               as ParentFraming
  component "attest_verify.rs\n(library half of CLI)"          as ParentAttestLib
  component "bin/cli.rs\nutexo-bridge-parent-cli"              as ParentCli
  component "bin/attest_verify.rs\nattest-verify CLI"          as AttestVerifyCli
  component "config.rs / error.rs"                              as ParentMisc
}

' =====================================================================
' attestation-verify crate (shared)
' =====================================================================
package "attestation-verify crate (shared)" as AttestPkg {
  component "verify_attestation()\nCOSE_Sign1 + AWS Nitro\ncert chain + PCRs"  as AttestVerify
  component "verify_mock_attestation()\n(feature = \"mock\")"                  as AttestMock
  component "build_mock_document()\n(feature = \"mock\")"                      as AttestBuildMock
  component "Embedded AWS Nitro\nroot CA (PEM)"                                as RootCa
}

' =====================================================================
' enclave crate
' =====================================================================
package "enclave crate (utexo-bridge-enclave)" as EnclavePkg {
  component "main.rs\nlistener loop\n(vsock or TCP)"                            as EnclaveMain
  component "server.rs\nServerContext + handler dispatch"                       as EnclaveServer
  component "state.rs\nEnclaveState\nPhase{Initial,Cloning,Active}\n+ NonceReplayGuard" as EnclaveState
  component "framing.rs\nlen-prefixed proto\n(4 MB cap)"                        as EnclaveFraming
  component "error.rs\nEnclaveError + error_code()"                             as EnclaveError
  component "config.rs\nBridgeConfig (env-pinned\nchain_id/contract/rgb_asset_id)" as BridgeCfg
  component "vsock_forwarder.rs\nTCP 127.0.0.1:3443\n-> vsock CID 3:8001"        as VsockFwd

  package "keys.rs" as KeysPkg {
    component "KeyManager\nBIP-39/32/84/86\nSecretBox seed+keys"  as KeyManager
  }
  package "signing/" as SigningPkg {
    component "evm.rs\nEIP-712 domain + digest"                 as SignEvm
    component "psbt.rs\nP2WSH segwit-v0\nanchor: script_pubkey" as SignPsbt
    component "taproot.rs\nBIP-341 script-path\nverify_taproot_commitment" as SignTaproot
  }
  package "validation/" as ValidationPkg {
    component "evm_crosscheck.rs\nselector allowlist + pinned-config\namount bound to consignment\n(funds_out burn/transfer)" as ValEvm
    component "psbt_crosscheck.rs\nbridge vs vanilla\namount consistency"       as ValPsbt
    component "rgb.rs\nrgbstd Transfer\n+ Esplora resolver"                     as ValRgb
    component "spv_crosscheck.rs\ncoverage + depth\n+ chain_net + staleness"    as ValSpv
  }
  package "spv/" as SpvPkg {
    component "chain.rs\nHeaderChain\nbounded reorg (<=100)"      as SpvChain
    component "checkpoint.rs\ncompile-time anchors\n-> PCR0"      as SpvCheckpoint
    component "merkle.rs\nBitcoin merkle proof"                  as SpvMerkle
    component "validation.rs\nlinkage + PoW + nBits"             as SpvValidation
    component "types.rs\nNetwork, SpvError"                      as SpvTypes
  }
  package "attestation + cloning" as ClonePkg {
    component "attestation.rs\nNSM facade\n+ verify_peer_attestation()" as AttestFacade
    component "cloning.rs\nCloneSession\nX25519 + HKDF-SHA256\n+ ChaCha20Poly1305" as Cloning
  }
}

' =====================================================================
' External infrastructure
' =====================================================================
node "AWS NSM device\n(/dev/nsm)" as NSM
cloud "Esplora indexer" as Esplora
node "host vsock-proxy\n(port 8001)"     as VsockProxy

' =====================================================================
' Wires
' =====================================================================
Listener     --> ParentMain        : gRPC : parentadapter.proto\nEnclaveService.{Sign, PublicKey,\nInitialize, Clone, SubmitHeaders,\nGetLastSavedBlock, AttestedPublicKey}
Operator     --> ParentCli         : shell
Verifier     --> AttestVerifyCli   : --pcr0/1/2 + endpoint
ParentCli    --> ParentClient
AttestVerifyCli --> ParentAttestLib
ParentAttestLib --> AttestVerify   : verify_attestation()
ParentAttestLib --> AttestMock     : (feature mock)

ParentMain   --> GrpcSrv
GrpcSrv      --> ParentFraming
GrpcSrv      ..> EnclaveFraming   : [u32 LE len][EnclaveRequest]\nTCP 127.0.0.1:5000  or  vsock CID 16:5000

EnclaveMain  --> EnclaveServer    : ServerContext{state, header_chain, rgb_validator}
EnclaveServer --> EnclaveFraming
EnclaveServer --> EnclaveState
EnclaveServer --> ValEvm
EnclaveServer --> ValPsbt
EnclaveServer --> ValRgb
EnclaveServer --> ValSpv
EnclaveServer --> AttestFacade    : InitiateCloning / GetClone / SetClone /\nGetAttestedPublicKey
EnclaveServer --> Cloning
EnclaveServer --> SpvChain        : SubmitHeaders / lookup

EnclaveState --> KeyManager       : Phase::Active(km)
KeyManager   --> SignEvm
KeyManager   --> SignPsbt
KeyManager   --> SignTaproot

ValRgb       --> Esplora          : esplora_blocking via\nlocalhost:3443
ValRgb       ..> VsockFwd         : (HTTP)
VsockFwd     --> VsockProxy       : vsock CID 3:8001
VsockProxy   --> Esplora          : real HTTP

ValSpv       --> SpvChain
ValSpv       --> SpvMerkle
SpvChain     --> SpvValidation
SpvChain     --> SpvCheckpoint
SpvChain     --> SpvTypes

AttestFacade --> NSM              : Linux only\nRequest::Attestation /\nDescribePCR
AttestFacade --> AttestVerify     : peer verification (real)
AttestFacade --> AttestMock       : peer verification (mock)
AttestFacade --> AttestBuildMock  : build mock doc
Cloning      ..> AttestFacade     : ephemeral pubkey <-> attestation user_data
AttestVerify --> RootCa           : OnceLock<Vec<u8>>

EnclaveError --> SpvTypes         : From<SpvError>

BridgeCfg    --> ValEvm           : pinned chain/contract/asset cross-check
BridgeCfg    ..> AttestFacade     : folded into canonical bundle\n(committed in attestation user_data)

@enduml
