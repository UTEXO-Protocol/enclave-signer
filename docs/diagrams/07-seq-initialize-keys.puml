@startuml seq-initialize-keys
title Initialize keys (first enclave in a cluster, from OS entropy)

skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #355680
  LifeLineBorderColor #555555
  ParticipantBorderColor #355680
  ParticipantBackgroundColor #FAFAFA
  ParticipantFontStyle bold
}

actor "Operator" as Op
participant "utexo-bridge-parent-cli\nbin/cli.rs" as Cli
participant "EnclaveClient\nparent/client.rs" as PClient
participant "enclave/server.rs\nhandle_initialize" as Srv
participant "EnclaveState\nstate.rs" as State
participant "KeyManager\nkeys.rs" as Km
participant "getrandom\n(OS entropy)" as Rand

Op -> Cli            : utexo-bridge-parent-cli init
Cli -> PClient       : initialize_keys(seed=None)
PClient -> Srv       : InitializeKeyRequest{seed=[], mnemonic=""}\n(length-prefixed proto)

Srv -> Srv           : path == "entropy" (no seed, no mnemonic)
Srv -> Rand          : getrandom::fill(&mut entropy[32])
Rand --> Srv         : 32 bytes
Srv -> State         : initialize_from_entropy(&mut entropy)

State -> State       : lock Phase
State -> State       : ensure_initial(guard) -> AlreadyInitialized otherwise
State -> Km          : KeyManager::generate(entropy, network)

Km -> Km             : Mnemonic::from_entropy(entropy); entropy.zeroize()
Km -> Km             : seed := mnemonic.to_seed("")
Km -> Km             : seed_box := SecretBox::new(seed); seed.zeroize()
Km -> Km             : master := Xpriv::new_master(network, seed)
Km -> Km             : EVM   = m/44'/60'/0'/0/0\nBTC   = m/84'/0'/0'/0/0\nBIP86 vanilla = m/86'/<coin>'/0'\nBIP86 colored = m/86'/827167'/0'
Km -> Km             : evm_address = keccak256(uncomp_pub[1..])[12..]
Km --> State         : (KeyManager, Mnemonic)

State -> State       : *guard = Phase::Active(Box::new(km))
State --> Srv        : mnemonic (one-time return for log)

Srv -> State         : get_keys()
State --> Srv        : KeyInfo

note over Srv
  tracing::info! evm_address, master_fingerprint,
  account_xpubs (public values only).
  The mnemonic is dropped here -- its content lives
  only in the SecretBox<seed> from now on.
end note

Srv --> PClient      : InitializeKeyResponse{evm_address, btc_compressed_pub,\nbtc_xpub, master_fingerprint, account xpubs,\nevm_uncompressed_pub}
PClient --> Cli      : print pubkeys
Cli --> Op           : enclave ready

@enduml
