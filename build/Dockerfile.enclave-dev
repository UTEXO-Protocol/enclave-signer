# syntax=docker/dockerfile:1.4
# Enclave (dev mode, TCP, no vsock)
# Usage:
#   DOCKER_BUILDKIT=1 docker build -f build/Dockerfile.enclave-dev -t utexo-bridge-enclave-dev .
#
# NO CREDENTIALS REQUIRED, same as Dockerfile.enclave: the enclave compiles
# against the in-tree `enclave-proto/` slice and every git dep is public HTTPS.

# ===== Builder Stage =====
FROM rust:1.96-slim AS builder

# `git` + `ca-certificates`: the `[patch.crates-io]` block and the
# rgb-consignment dep are public HTTPS git URLs, and `.cargo/config.toml` sets
# `net.git-fetch-with-cli = true` so cargo shells out to system `git` rather
# than bundled libgit2. No SSH transport is used, so no `openssh-client`.
# `protobuf-compiler` is NOT needed: no crate here has a build.rs.
RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build/

WORKDIR /build/enclave
# Dev image still gets `spv` so the new code path is exercised even
# without the production-only `vsock,rgb-validation` combo. Without spv,
# the enclave fails-closed on any request that carries merkle_proofs,
# which is what we want — build mismatch should always fail loudly.
#
# DEBUG build (no `--release`): `allow-seed-import` is one of the dev-only
# features that `compile_error!`s in a release build (`debug_assertions`
# off) — see the release guards in `enclave/src/lib.rs`. Building the dev
# image in debug keeps `debug_assertions` on so the guard stays quiet while
# still refusing the feature in any production (release) build.
#
# `--no-default-features` is REQUIRED. The RGB/CCD split set
# `default = ["rgb", "ccd", "helios"]` in enclave/Cargo.toml, and a plain
# `--features` still applies defaults — so this image would silently pull
# `helios`, whose reqwest -> native-tls -> openssl-sys chain builds OpenSSL
# from source. This builder stage installs no `make`, so that build FAILS.
# The release Dockerfiles already pass `--no-default-features` for the same
# reason; keep the feature list here exhaustive and explicit.
#
# `ccd` is listed explicitly: Concordium signing (SignCcd / CcdSource) now
# sits behind that feature, and without it this image would answer every CCD
# request with "not compiled in" — a silent capability loss versus the
# pre-split build, where CCD was always compiled.
RUN cargo build --no-default-features --features allow-seed-import,spv,ccd,evm-rpc

# ===== Runtime Stage =====
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m enclave

WORKDIR /home/enclave

COPY --from=builder /build/target/debug/utexo-bridge-enclave ./utexo-bridge-enclave

RUN chown -R enclave:enclave .

USER enclave

ENV ENCLAVE_LISTEN_ADDR=0.0.0.0:5000
ENV BITCOIN_NETWORK=testnet
ENV RUST_LOG=debug

EXPOSE 5000

ENTRYPOINT ["./utexo-bridge-enclave"]
