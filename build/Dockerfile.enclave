# syntax=docker/dockerfile:1.7
# Combined enclave image, retired swap flow (vsock + rgb + rgb-swap + ccd +
# bfa-validation). Not a production image: see Dockerfile.enclave.mint/.burn.
# Private Cargo dependencies require BuildKit secrets (see README, Building).
# Supply github_token, or one deploy key per repo; keys never enter image layers.
# Example: docker build --secret id=github_token,env=GITHUB_TOKEN -f build/Dockerfile.enclave .
# Use the same Debian release for the builder and runtime.
FROM rust:1.96.1-slim-trixie@sha256:31ee7fc65186be7e0e0ccb3f2ca305f14e4739e7642a1ae65753aa5d7b874523 AS builder

# Pin packages to a signed snapshot over HTTPS.
# Disable expiry checks so the fixed snapshot remains usable after Valid-Until.
RUN set -eux; \
    printf '%s\n' \
      'deb https://snapshot.debian.org/archive/debian/20261007T000000Z trixie main' \
      'deb https://snapshot.debian.org/archive/debian-security/20261007T000000Z trixie-security main' \
      > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/*; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\n' > /etc/apt/apt.conf.d/99snapshot; \
    apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev git ca-certificates openssh-client make cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build/

WORKDIR /build/enclave
# Deterministic compilation (PCR0 reproducibility, Step 4):
#   CARGO_INCREMENTAL=0   no incremental artifacts (release already off; explicit)
#   --remap-path-prefix   strip the absolute build path from embedded paths
#   -C debuginfo=0 / strip=symbols  drop debug info + symbol tables (a common
#                         source of binary variation; also shrinks the binary)
# The container paths (/build, $CARGO_HOME) are already constant, so combined with
# `--locked` below the compiled binary is stable across rebuilds of the same commit.
ENV CARGO_INCREMENTAL=0 \
    RUSTFLAGS="--remap-path-prefix=/build=/src -C debuginfo=0 -C strip=symbols"
# Build the RGB swap, BFA validation, and CCD features.
# bfa-validation enables evm-rpc through the host proxy on port 8002.
# For debug tests only: allow-debug-pcrs accepts all-zero peer PCRs.
# Leave this argument empty for production builds. (F03-AF-12)
ARG ENCLAVE_DEBUG_FEATURES=""
RUN --mount=type=secret,id=github_token \
    --mount=type=secret,id=consensus_key \
    --mount=type=secret,id=ops_key \
    --mount=type=secret,id=schemas_key \
    sh /build/build/with-private-deps.sh enclave cargo build --release --locked --features vsock,rgb,rgb-swap,ccd,bfa-validation${ENCLAVE_DEBUG_FEATURES:+,${ENCLAVE_DEBUG_FEATURES}}


# --- Runtime ---
# Pin the measured rootfs by digest. Update both stages together.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS runtime

# Bootstrap HTTPS before the runtime installs its CA package.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# Disable expiry checks for the fixed snapshot; keep signature checks enabled.
# Remove package-manager logs and caches in the installation layer.
RUN set -eux; \
    printf '%s\n' \
      'deb https://snapshot.debian.org/archive/debian/20261007T000000Z trixie main' \
      'deb https://snapshot.debian.org/archive/debian-security/20261007T000000Z trixie-security main' \
      > /etc/apt/sources.list; \
    rm -f /etc/apt/sources.list.d/*; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "5";\n' > /etc/apt/apt.conf.d/99snapshot; \
    printf 'Acquire::https::CaInfo "/etc/ssl/certs/ca-certificates.crt";\n' > /etc/apt/apt.conf.d/98ca; \
    apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates socat iproute2 libssl3t64 libstdc++6 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
        /var/cache/debconf /var/cache/ldconfig /var/log/* /tmp/*

WORKDIR /app
COPY --from=builder /build/target/release/utexo-bridge-enclave /app/utexo-bridge-enclave
COPY build/entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/utexo-bridge-enclave /app/entrypoint.sh
# Reject missing libraries or incompatible symbol versions before EIF conversion.
RUN /lib64/ld-linux-x86-64.so.2 --list /app/utexo-bridge-enclave > /dev/null

# NOTE: the donor cloning secret is intentionally NOT baked here. It is
# delivered at runtime via the `InitializeKey` message (CLI: `init
# --cloning-secret <secret>`), so it never lands in the EIF / image layers and
# the PCRs stay reproducible. See enclave/src/server/keys.rs (handle_initialize).

# Pinned bridge/indexer config - public identifiers, baked so PCR0 commits to
# them (attestation proves which chain/contract/asset this enclave serves) and
# so builders with dependency access can reproduce the same pins. Stage runs on Bitcoin
# MAINNET + Arbitrum One (chain_id 42161). Electrum is set at launch. The
# enclave pins its host to 127.0.0.1 and reaches it over the vsock forwarder
# (host runs `vsock-proxy 8001 <electrum host> <port>`); TLS terminates in-enclave.
# TWO-CONTRACT deployment: the EVM funds-out EIP-712 verifyingContract is the
# MultisigProxy (EVM_PROXY_CONTRACT_ADDRESS), which DIFFERS from the bridge
# *entry* contract that emits FundsIn (FUNDS_IN_CONTRACT, set below). The listener
# stamps EVM_PROXY_CONTRACT_ADDRESS into every funds-out request; the enclave
# cross-checks it (see enclave/src/config.rs + networks/evm/validation.rs).
ARG RGB_ASSET_ID=""
RUN test -n "$RGB_ASSET_ID"
ENV EVM_CHAIN_ID=42161 \
    EVM_PROXY_CONTRACT_ADDRESS=0xC985c12bbCECe96A13A72A62FD75d8aB9381ef5A \
    RGB_ASSET_ID=${RGB_ASSET_ID} \
    BITCOIN_NETWORK=bitcoin

# In-enclave EVM `FundsIn` verification config (evm-rpc), baked so PCR0
# commits to the verification policy. The enclave reaches the EVM RPC only
# through the vsock forwarder (host runs
# `vsock-proxy <EVM_RPC_VSOCK_PORT=8002> <rpc host> <tls port>`).
# Receipts must be covered by EVM_FINALITY_TAG (latest, safe, finalized) and
# match the canonical block hash; missing tag support fails closed.
# FUNDS_IN_CONTRACT is set EXPLICITLY to the bridge *entry* contract (the FundsIn
# event emitter). It MUST be explicit here because it differs from
# EVM_PROXY_CONTRACT_ADDRESS (the MultisigProxy) - leaving it unset would fall
# back to the proxy address and make FundsIn verification look at the wrong contract.
#
# Operational signing-policy pins for the plain-BTC (`SignBtc`) and gas-tx
# (`SignRawDigest`) paths. The listener routes to them by DataType: `BTC_UTXO`
# -> SignBtcRequest and `EVM_GAS_TX` -> SignRawDigest, so create_utxos, send_btc
# and gas-funding flow through here. A release (`rgb-validation`) build fails
# these paths closed unless pinned, so real values are baked in (public, and
# committed into PCR0):
#   - BTC_MAX_TOTAL_SATS: cap on total input value spent.
#   - GAS_TX_ALLOWED_TO: the only `to` a gas tx may target, here the bridge entry
#     contract (== FUNDS_IN_CONTRACT, not the MultisigProxy).
# The former BTC_ALLOWED_SCRIPTS allowlist was removed upstream: the scripts
# derive from a post-boot seed, and enclave env is measured into PCR0. The
# enclave derives output ownership. Unproven outputs need an unowned-sats budget.
# Gas signing also needs fee/gas ceilings and allowed selectors, unset here.
# Bridge PSBTs need RGB_MAX_UNOWNED_SATS, also unset here.
# The operator sets the Electrum URL and EVM RPC host, CA, and TLS port at launch.
# The policy commits the hosts and CA hash, but not ports or the Electrum scheme.
# See docs/tee-spec.md.
ENV EVM_FINALITY_TAG=safe \
    FUNDS_IN_CONTRACT=0x6711f1a319B37847fa0234181C34D883774c4951 \
    TOKEN_CONTRACT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9 \
    GAS_TX_ALLOWED_TO=0x6711f1a319B37847fa0234181C34D883774c4951 \
    BTC_MAX_TOTAL_SATS=1000000

# Production logging. RUST_LOG reaches the tracing EnvFilter (main.rs
# from_default_env).
#
# This env is measured into PCR0, so do not flip it to `debug` for a production
# EIF. For a verbose build, use a throwaway branch and run the enclave with
# `--debug-mode`, which zeroes the PCRs anyway.
ENV RUST_LOG=info
ENTRYPOINT ["/app/entrypoint.sh"]
