# syntax=docker/dockerfile:1.4
# Parent Adapter (gRPC proxy to Enclave)
# Usage:
#   DOCKER_BUILDKIT=1 docker build --ssh default \
#     -f build/Dockerfile.parent -t utexo-bridge-parent .
#
# `--ssh default` is required for ONE private git dep: `federated-signer-proto`,
# the full schema (bridge / node / orchestrator / parent / signer packages) that
# only the parent needs. The enclave uses the vendored `enclave-proto/` slice
# and needs no credential at all.
#
# Unlike the enclave image, this one is NOT part of the public reproducibility
# story: the parent runs on the untrusted host and is not measured into any PCR.
#
# Dev (TCP to enclave container):
#   docker run -e ENCLAVE_ADDR=enclave:5000 utexo-bridge-parent
#
# Production (vsock to Nitro enclave):
#   docker run --device /dev/vsock:/dev/vsock \
#     -e USE_VSOCK=true -e ENCLAVE_VSOCK_CID=16 \
#     utexo-bridge-parent

# ===== Builder Stage =====
FROM rust:1.96-slim AS builder

# `git` + `ca-certificates`: `parent/Cargo.toml`'s `[patch.crates-io]` rewrites
# rgb-ops / rgb-invoicing / rgb-strict-encoding to public git URLs, and
# `.cargo/config.toml` sets `net.git-fetch-with-cli = true` so cargo shells out
# to system `git` instead of bundled libgit2.
# `openssh-client` is needed for the one private SSH dep, federated-signer-proto.
# `protobuf-compiler` is NOT needed: the proto crate ships pre-generated and no
# crate here has a build.rs, so protoc never runs.
RUN apt-get update && apt-get install -y \
    pkg-config libssl-dev git ca-certificates openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Trust github.com's SSH host key so the build doesn't prompt or fail
# on host-key verification when fetching the private parser dep.
RUN mkdir -p /root/.ssh && \
    ssh-keyscan -t ed25519,ecdsa github.com >> /root/.ssh/known_hosts

WORKDIR /build
COPY . /build/

# `--mount=type=ssh` exposes the SSH_AUTH_SOCK forwarded by `--ssh default`.
# In CD we also pass the deploy key as a BuildKit secret so git uses exactly
# that identity (a shared agent may offer the wrong key first, and GitHub then
# answers "Repository not found"). `required=false` keeps local agent-only
# builds working.
RUN --mount=type=ssh \
    --mount=type=secret,id=federated_key,required=false \
    set -eu; \
    if [ -f /run/secrets/federated_key ]; then \
      install -m 600 /run/secrets/federated_key /tmp/federated_key; \
      export GIT_SSH_COMMAND="ssh -i /tmp/federated_key -o IdentitiesOnly=yes"; \
    fi; \
    cd /build/parent && cargo build --release

# ===== Runtime Stage =====
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m parent

WORKDIR /home/parent

# `parent/` is its own workspace, so its target dir is nested, not at /build.
COPY --from=builder /build/parent/target/release/utexo-bridge-parent ./utexo-bridge-parent

RUN chown -R parent:parent .

USER parent

ENV GRPC_HOST=0.0.0.0
ENV GRPC_PORT=5000
ENV ENCLAVE_ADDR=127.0.0.1:5000
ENV USE_VSOCK=false
ENV ENCLAVE_VSOCK_CID=16
ENV ENCLAVE_VSOCK_PORT=5000
ENV RUST_LOG=debug

EXPOSE 5000

ENTRYPOINT ["./utexo-bridge-parent"]
