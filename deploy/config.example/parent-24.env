GRPC_HOST=
GRPC_PORT=50055
GRPC_TLS_CERT_FILE=/etc/utexo/tls/24/server.pem
GRPC_TLS_KEY_FILE=/etc/utexo/tls/24/server.key
GRPC_TLS_CLIENT_CA_FILE=/etc/utexo/tls/24/client-ca.pem
GRPC_TLS_ACL_FILE=/etc/utexo/tls/24/clients.acl
GRPC_MAX_CONCURRENT=128
GRPC_MAX_CONCURRENT_PER_CONN=32
GRPC_REQUEST_TIMEOUT_SECS=120
GRPC_MAX_CONNECTIONS=64
GRPC_CLONE_MAX_PER_MINUTE=30
HEALTH_HOST=127.0.0.1
HEALTH_PORT=50065
USE_VSOCK=true
ENCLAVE_VSOCK_CID=24
ENCLAVE_VSOCK_PORT=5000
HEADER_ELECTRUM_URL=
HEADER_SYNC_INTERVAL_SECS=10
RUST_LOG=debug
KMS_SEED_ID=
KMS_S3_BUCKET=
KMS_S3_KEY=
AWS_REGION=
KMS_ALLOWED_CIDS=24
KMS_BROKER_PORT=8004
