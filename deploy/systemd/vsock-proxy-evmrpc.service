[Unit]
# EVM-RPC egress for the in-enclave FundsIn verification (evm-rpc feature).
# The enclave speaks TLS to https://<EVM_RPC_HOST> through its loopback
# 127.0.0.1:3444, which the in-enclave forwarder relays over vsock port 8002.
# TLS ends inside the enclave, so this proxy relays ciphertext only.
# deploy/host-prep-evmrpc.sh writes the environment file and the allowlist.
Description=vsock-proxy for enclave EVM RPC (evm-rpc FundsIn verify: vsock 8002 -> EVM_RPC_HOST:EVM_RPC_TLS_PORT)
After=network-online.target nitro-enclaves-allocator.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/nitro_enclaves/vsock-proxy-evmrpc.env
ExecStart=/usr/bin/vsock-proxy 8002 ${EVM_RPC_HOST} ${EVM_RPC_TLS_PORT} --config /etc/nitro_enclaves/vsock-proxy-evmrpc.yaml
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
