[Unit]
Description=RGB swaps KMS TLS relay (vsock 8003 to regional KMS HTTPS)
Wants=network-online.target
After=network-online.target nitro-enclaves-allocator.service

[Service]
Type=simple
DynamicUser=yes
# Replace REPLACE_AWS_REGION here and in vsock-proxy-kms.yaml. TLS is
# authenticated inside the enclave; this proxy only forwards encrypted bytes.
# Do not use an HTTP proxy, TLS termination, or the EVM nginx shim for KMS.
ExecStart=/usr/bin/vsock-proxy 8003 kms.REPLACE_AWS_REGION.amazonaws.com 443 --config /etc/nitro_enclaves/vsock-proxy-kms.yaml
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
UMask=0077
TasksMax=32
MemoryMax=128M
RestrictAddressFamilies=AF_VSOCK AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
